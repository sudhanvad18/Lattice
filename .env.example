# Lattice Configuration
# Copy this file to .env and fill in your values.
# For local development, the defaults work out of the box with Ollama.

# --- Inference Provider ---
# Options: ollama, anthropic, openai
LATTICE_DEFAULT_PROVIDER=ollama
LATTICE_OLLAMA_BASE_URL=http://localhost:11434
LATTICE_OLLAMA_MODEL=llama3.2

# Uncomment and fill for cloud providers:
# LATTICE_ANTHROPIC_API_KEY=sk-ant-...
# LATTICE_OPENAI_API_KEY=sk-...

# --- Knowledge Graph ---
# Options: networkx (in-memory, no setup), neo4j (requires Neo4j instance)
LATTICE_GRAPH_BACKEND=networkx

# --- Vector Store ---
LATTICE_CHROMA_PERSIST_DIR=data/chroma
LATTICE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Redis (optional — in-memory fallback used if not set) ---
# LATTICE_REDIS_URL=redis://localhost:6379

# --- GitHub Write-Back (optional) ---
# LATTICE_GITHUB_TOKEN=ghp_...

# --- Observability (optional) ---
# LATTICE_LANGFUSE_PUBLIC_KEY=pk-...
# LATTICE_LANGFUSE_SECRET_KEY=sk-...
LATTICE_ENABLE_TRACING=false

# --- General ---
LATTICE_LOG_LEVEL=INFO
LATTICE_DEBUG=false
