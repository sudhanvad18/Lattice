FROM python:3.11-slim

WORKDIR /app

# Install from the repository-root manifest, including every package it lists.
# `mcp` is not a project dependency; the server imports it directly.
COPY pyproject.toml README.md ./
COPY packages/core ./packages/core
COPY packages/api ./packages/api
COPY packages/mcp ./packages/mcp

RUN pip install --no-cache-dir . mcp

EXPOSE 8100

CMD ["python", "-m", "lattice_mcp.server"]
